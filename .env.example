# Copy this file to .env and fill only the credentials you use. NEVER commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Local SQLite (recommended first for integration tests)
DB_ENGINE=sqlite3

# To use PostgreSQL later, set DB_ENGINE=postgresql and fill these:
DB_NAME=dol_ielts
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=5432

# Optional AI Writing grading, server-side only.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_API_TIMEOUT=15
